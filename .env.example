POSTGRES_DB=mopl
POSTGRES_USER=mopl
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT_SECRET 생성 명령어 (PowerShell)
# $bytes = New-Object byte[] 64
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)

JWT_SECRET=replace-with-64-byte-base64-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_ISSUER=mopl

ADMIN_EMAIL=admin@mopl.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=<SET_A_STRONG_RANDOM_PASSWORD_BEFORE_STARTUP>

AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Temporary password email SMTP settings
MAIL_FROM=your-email@example.com
MAIL_HOST=smtp.gmail.com

# Naver: 네이버 메일 환경설정에서 POP3/SMTP 사용을 활성화한 뒤, 보안 설정에서 애플리케이션 비밀번호를 생성해 입력한다.
# Google: Google 계정 2단계 인증을 활성화한 뒤, 앱 비밀번호를 생성해 입력한다.
MAIL_PASSWORD=your-app-password

MAIL_PORT=587
MAIL_USERNAME=your-email@example.com

# 임시 비밀번호 발송 로직을 포함하려는 경우 추가
#PASSWORD_RESET_MAIL_MODE=smtp

# TMDB Read Access Token 발급: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# TheSportsDB 무료 테스트 키: 123 (발급 불필요, https://www.thesportsdb.com/documentation 참고)
SPORTS_DB_API_KEY=123

# OAuth
# OAuth 기능을 실제로 사용할 때는 SPRING_PROFILES_ACTIVE에 oauth를 추가합니다.
# local: SPRING_PROFILES_ACTIVE=dev,oauth
# prod: SPRING_PROFILES_ACTIVE=prod,oauth
OAUTH_ENABLED=false

# OAuth redirect URI
# 운영 환경에서는 배포 도메인을 기준으로 설정합니다.
OAUTH_SUCCESS_REDIRECT_URI=https://moduplaylist.site/
OAUTH_FAILURE_REDIRECT_URI=https://moduplaylist.site/\#/sign-in

# Google OAuth
# Google Cloud Console에서 Web application OAuth Client를 생성한 뒤 입력합니다.
# Authorized redirect URI:
# https://moduplaylist.site/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth
# Kakao Developers에서 애플리케이션 생성 후 REST API 키를 client id로 입력합니다.
# Redirect URI:
# https://moduplaylist.site/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=