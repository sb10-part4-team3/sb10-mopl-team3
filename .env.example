POSTGRES_DB=mopl
POSTGRES_USER=mopl
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT_SECRET 생성 명령어 (PowerShell)
# $bytes = New-Object byte[] 64
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)

JWT_SECRET=replace-with-64-byte-base64-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_ISSUER=mopl

ADMIN_EMAIL=admin@mopl.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=<SET_A_STRONG_RANDOM_PASSWORD_BEFORE_STARTUP>

AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Temporary password email SMTP settings
# Gmail을 사용할 경우 일반 계정 비밀번호가 아니라 앱 비밀번호를 사용해야 합니다.
MAIL_FROM=your-email@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PASSWORD=your-app-password
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com

# TMDB Read Access Token 발급: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# TheSportsDB 무료 테스트 키: 123 (발급 불필요, https://www.thesportsdb.com/documentation 참고)
SPORTS_DB_API_KEY=123
