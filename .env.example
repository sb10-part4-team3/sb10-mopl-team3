POSTGRES_DB=mopl
POSTGRES_USER=mopl
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT_SECRET generation command (PowerShell)
# $bytes = New-Object byte[] 64
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
JWT_SECRET=replace-with-64-byte-base64-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_ISSUER=mopl

ADMIN_EMAIL=admin@mopl.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=<SET_A_STRONG_RANDOM_PASSWORD_BEFORE_STARTUP>

AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Temporary password email SMTP settings
MAIL_FROM=your-email@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
# Naver: enable POP3/SMTP in mail settings, then create and use an app password.
# Google: enable 2-Step Verification, then create and use an app password.
MAIL_PASSWORD=your-app-password

# Enable SMTP mail sending instead of log mode.
# PASSWORD_RESET_MAIL_MODE=smtp

# TMDB Read Access Token: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# TheSportsDB free test key is 123.
SPORTS_DB_API_KEY=123

# OAuth
# Enable the oauth profile only after provider credentials and redirect URIs are configured.
# local OAuth QA: SPRING_PROFILES_ACTIVE=dev,oauth
# prod OAuth: SPRING_PROFILES_ACTIVE=prod,oauth
OAUTH_ENABLED=false

# OAuth redirect URI
# Use the deployed domain in production.
OAUTH_SUCCESS_REDIRECT_URI=https://moduplaylist.site/
OAUTH_FAILURE_REDIRECT_URI=https://moduplaylist.site/\#/sign-in

# Google OAuth
# Create a Web application OAuth Client in Google Cloud Console.
# Authorized redirect URI:
# https://moduplaylist.site/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth
# Use the REST API key from Kakao Developers as the client id.
# Redirect URI:
# https://moduplaylist.site/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
